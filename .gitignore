.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
.cache/
.DS_Store
*.swp
.env
.env.*
!.env.example

# Dữ liệu gốc, cache và output sinh ra không được đưa vào Git.
data/raw/*
data/processed/*
results/

# Giữ mã nguồn, hình và PDF báo cáo; bỏ qua tệp trung gian LaTeX.
reports/latex/*.aux
reports/latex/*.log
reports/latex/*.out
reports/latex/*.toc
reports/latex/*.lof
reports/latex/*.lot
reports/latex/*.synctex.gz

# Manifest được tạo cho model cục bộ, không thay manifest lịch sử.
configs/e6_manifest_moi.json
!**/.gitkeep

# Bằng chứng thực nghiệm nhỏ; model, cache và ma trận nhị phân vẫn bị bỏ qua.
!results/
results/*
!results/v5/
results/v5/*
!results/v5/*.json
!results/v5/*.csv
!results/final_test/
results/final_test/*
!results/final_test/*.json
!results/final_test/*.csv
!results/v4/
results/v4/*
!results/v4/dataset_audit.json
!results/v4/duplicate_candidates.csv
